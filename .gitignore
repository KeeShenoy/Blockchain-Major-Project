*.proof
proof.bin
# Proofs from end-to-end runs are evidence for the reported results.
!evaluation/results/**/*.proof

# Logs. The end-to-end log is the record cited in docs/results.md.
*.log
!evaluation/results/**/e2e.log

# Older raw benchmark output, summarized in docs/phase6-benchmark.md
evaluation/output/

